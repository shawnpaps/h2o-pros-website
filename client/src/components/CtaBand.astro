---
import Button from './Button.astro';
import BookOnlineButton from './BookOnlineButton.astro';
import { getPageCta, getSiteContent, type PageHeadlinePage } from '../lib/cms';

interface Props {
  /** Built-in wording for the page this band sits on. */
  title?: string;
  description?: string;
  /**
   * Lets the editor override this page's band (wording and button text) from
   * the page's Main Page Headline entry in the CMS.
   */
  page?: PageHeadlinePage;
}

const { site, cta } = await getSiteContent();
const { title: pageTitle, description: pageDescription, page } = Astro.props;
const override = page ? await getPageCta(page) : {};

// Most specific wins: the CMS entry for this page, then the wording the page
// passes in, then the site-wide Call-to-Action Band text.
const title = override.title || pageTitle || cta.title;
const description = override.description || pageDescription || cta.description;
const bookLabel = override.bookLabel || 'Book Online';
const callLabel = override.callLabel || `Call ${site.phone}`;
---

<section class="bg-brand-red" aria-labelledby="cta-band-title">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-4 py-16 text-center sm:px-6 lg:flex-row lg:justify-between lg:text-left lg:px-8"
  >
    <div class="max-w-2xl">
      <h2 id="cta-band-title" class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {title}
      </h2>
      <p class="mt-3 text-lg text-white/80">{description}</p>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row">
      <BookOnlineButton
        size="lg"
        class="!bg-white !text-brand-red hover:!bg-white/90 focus-visible:!ring-white"
      >
        {bookLabel}
      </BookOnlineButton>
      <Button href={site.phoneHref} variant="outline" size="lg" class="text-white">
        {callLabel}
      </Button>
    </div>
  </div>
</section>
