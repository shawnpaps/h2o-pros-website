---
import logo from '../assets/logos/h2o-logo.webp';
import { getSiteContent } from '../lib/cms';

interface Props {
	tone?: 'light' | 'dark';
	/**
	 * Drops the wordmark down to just the mark until there is room for it
	 * (2xl). The header uses this so the nav row fits on one line; the link
	 * keeps its aria-label, so the name is still announced either way.
	 */
	compact?: boolean;
}

const { tone = 'light', compact = false } = Astro.props;
const { site, logoUrl } = await getSiteContent();
const wordColor = tone === 'dark' ? 'text-white' : 'text-ink';
const subColor = tone === 'dark' ? 'text-white/60' : 'text-ink/50';
---

<a
	href="/"
	class="inline-flex items-center gap-3 rounded-btn focus:outline-none focus-visible:ring-2 focus-visible:ring-water"
	aria-label={`${site.shortName} — home`}
>
	<img
		src={logoUrl ?? logo.src}
		width={logo.width}
		height={logo.height}
		alt=""
		class="h-20 w-auto"
	/>
	<span
		class={`font-heading text-lg font-extrabold ${compact ? 'hidden 2xl:block ' : ''}${wordColor}`}
	>
		{site.name}
		{
			site.tagline && (
				<span class={`block text-sm font-normal ${subColor}`}>
					{site.tagline}
				</span>
			)
		}
	</span>
</a>
