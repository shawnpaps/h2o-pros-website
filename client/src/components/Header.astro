---
import Logo from './Logo.astro';
import Button from './Button.astro';
import BookOnlineButton from './BookOnlineButton.astro';
import { getCounties, getLocations, getSiteContent } from '../lib/cms';

interface Props {
	/** "dark" sits transparently over the home hero; "light" is for interior pages. */
	variant?: 'dark' | 'light';
}

const { variant = 'light' } = Astro.props;
const { site, nav } = await getSiteContent();
// getCounties() already sorts by name; the menu lists cities alphabetically
// too, rather than in the CMS display order the location pages use. A leading
// "The" is ignored so "The Villages" files under V.
const sortKey = (name: string) => name.replace(/^the\s+/i, '');
const counties = await getCounties();
const cities = [...(await getLocations())].sort((a, b) =>
	sortKey(a.city).localeCompare(sortKey(b.city)),
);
const isDark = variant === 'dark';

type NavItem = { label: string; href: string };

// The Service Areas menu slots in right after the Services link; if the CMS nav
// ever drops that link, it lands at the end instead.
const splitAtServices = (items: NavItem[]) => {
	const index = items.findIndex((item) => item.href === '/our-services');
	const at = index === -1 ? items.length : index + 1;
	return [items.slice(0, at), items.slice(at)] as const;
};

// The secondary pages collapse into a "More" menu so the desktop row stays on
// one line. The mobile menu has the room to list them flat, so it still does.
const moreHrefs = ['/about-us', '/gallery', '/contact'];
const moreItems = nav.filter((item) => moreHrefs.includes(item.href));
const [navBefore, navAfter] = splitAtServices(
	nav.filter((item) => !moreHrefs.includes(item.href)),
);
const [mobileBefore, mobileAfter] = splitAtServices([...nav]);

const wrapper = isDark
	? 'absolute inset-x-0 top-0 z-50'
	: 'sticky top-0 z-50 border-b border-line bg-ink-deep/90 backdrop-blur';
const linkColor = isDark
	? 'text-ink/80 hover:text-white'
	: 'text-ink/70 hover:text-white';
const phoneColor = isDark ? 'text-white' : 'text-ink';
const phoneSub = isDark ? 'text-white/60' : 'text-ink/50';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// The FAQs live on the home page, so the link is an anchor from there and a
// jump back home from anywhere else.
const faqHref = '/#faqs';
const areasActive =
	currentPath.startsWith('/counties') || currentPath.startsWith('/locations');
const moreActive = moreItems.some((item) => item.href === currentPath);

const navLink = `rounded-btn py-2 font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-water ${linkColor}`;
const mobileNavLink = `block rounded-btn px-3 py-3 font-heading text-lg font-bold ${isDark ? 'text-white hover:bg-white/10' : 'text-ink hover:bg-mist'} focus:outline-none focus-visible:ring-2 focus-visible:ring-water`;
const panelHeading =
	'text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink/50';
const panelLink =
	'block rounded-btn px-2 py-1.5 text-sm font-semibold text-ink/80 transition hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-water';
---

<header class={wrapper}>
	<div
		class="mx-auto flex max-w-7xl items-center bg-white/10 hover:bg-white/15 transition-all ease-linear backdrop-blur-lg my-4 rounded-panel justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
	>
		<Logo />

		<nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
			{
				navBefore.map((item) => (
					<a
						href={item.href}
						aria-current={currentPath === item.href ? 'page' : undefined}
						class={`${navLink} ${currentPath === item.href ? 'text-brand-red' : ''}`}>
						{item.label}
					</a>
				))
			}

			<div class="relative" data-menu>
				<button
					type="button"
					data-menu-toggle
					aria-expanded="false"
					aria-controls="service-areas-panel"
					class={`flex items-center gap-1.5 whitespace-nowrap ${navLink} ${areasActive ? 'text-brand-red' : ''}`}
				>
					Service Areas
					<svg
						data-menu-chevron
						class="h-4 w-4 transition-transform"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M6 9l6 6 6-6"></path>
					</svg>
				</button>

				<div
					id="service-areas-panel"
					data-menu-panel
					hidden
					class="absolute left-1/2 top-full z-50 w-[min(40rem,85vw)] -translate-x-1/2 pt-3"
				>
					<div
						class="grid max-h-[70vh] gap-8 overflow-y-auto rounded-panel border border-line bg-ink-deep/95 p-6 shadow-soft backdrop-blur-lg sm:grid-cols-2"
					>
						<div>
							<p class={panelHeading}>Counties</p>
							<ul class="mt-3 space-y-1">
								{
									counties.map((county) => (
										<li>
											<a href={`/counties/${county.slug}`} class={panelLink}>
												{county.name} County
											</a>
										</li>
									))
								}
							</ul>
						</div>
						<div>
							<p class={panelHeading}>Cities</p>
							<ul class="mt-3 space-y-1">
								{
									cities.map((city) => (
										<li>
											<a href={`/locations/${city.slug}`} class={panelLink}>
												{city.city}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
			</div>

			{
				navAfter.map((item) => (
					<a
						href={item.href}
						aria-current={currentPath === item.href ? 'page' : undefined}
						class={`${navLink} ${currentPath === item.href ? 'text-brand-red' : ''}`}>
						{item.label}
					</a>
				))
			}

			<a href={faqHref} data-faq-link class={navLink}>FAQs</a>

			{
				moreItems.length > 0 && (
					<div class="relative" data-menu>
						<button
							type="button"
							data-menu-toggle
							aria-expanded="false"
							aria-controls="more-panel"
							class={`flex items-center gap-1.5 ${navLink} ${moreActive ? 'text-brand-red' : ''}`}>
							More
							<svg
								data-menu-chevron
								class="h-4 w-4 transition-transform"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true">
								<path d="M6 9l6 6 6-6" />
							</svg>
						</button>

						<div
							id="more-panel"
							data-menu-panel
							hidden
							class="absolute left-1/2 top-full z-50 w-56 -translate-x-1/2 pt-3">
							<ul class="rounded-panel border border-line bg-ink-deep/95 p-3 shadow-soft backdrop-blur-lg">
								{moreItems.map((item) => (
									<li>
										<a
											href={item.href}
											aria-current={
												currentPath === item.href ? 'page' : undefined
											}
											class={`${panelLink} ${currentPath === item.href ? 'text-brand-red' : ''}`}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				)
			}
		</nav>

		<div class="hidden items-center gap-5 md:flex">
			<a
				href={site.phoneHref}
				class="rounded-btn text-right leading-none focus:outline-none focus-visible:ring-2 focus-visible:ring-water"
			>
				<span
					class={`block whitespace-nowrap text-[0.65rem] font-bold uppercase tracking-[0.2em] ${phoneSub}`}
				>
					Call or text
				</span>
				<span
					class={`mt-1 block whitespace-nowrap font-heading text-lg font-extrabold ${phoneColor}`}
				>
					{site.phone}
				</span>
			</a>
			<BookOnlineButton>Book Online</BookOnlineButton>
		</div>

		<button
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="mobile-menu"
			class={`grid h-11 w-11 place-items-center rounded-btn lg:hidden ${isDark ? 'text-white' : 'text-ink'} focus:outline-none focus-visible:ring-2 focus-visible:ring-water`}
		>
			<span class="sr-only">Open menu</span>
			<svg
				data-icon-open
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
			<svg
				data-icon-close
				class="hidden"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>

	<div
		id="mobile-menu"
		hidden
		class={`lg:hidden ${isDark ? 'bg-ink-deep/95 backdrop-blur' : 'border-b border-line bg-ink-deep/95 backdrop-blur'}`}
	>
		<nav
			class="mx-auto max-w-7xl space-y-1 px-4 py-4 sm:px-6"
			aria-label="Mobile"
		>
			{
				mobileBefore.map((item) => (
					<a
						href={item.href}
						aria-current={currentPath === item.href ? 'page' : undefined}
						class={mobileNavLink}>
						{item.label}
					</a>
				))
			}

			<button
				type="button"
				data-areas-mobile-toggle
				aria-expanded="false"
				aria-controls="mobile-service-areas"
				class={`flex w-full items-center justify-between ${mobileNavLink}`}
			>
				Service Areas
				<svg
					data-areas-chevron
					class="h-5 w-5 transition-transform"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M6 9l6 6 6-6"></path>
				</svg>
			</button>
			<div id="mobile-service-areas" hidden class="px-3 pb-2">
				<p class={panelHeading}>Counties</p>
				<ul class="mb-4 mt-2 space-y-1">
					{
						counties.map((county) => (
							<li>
								<a href={`/counties/${county.slug}`} class={panelLink}>
									{county.name} County
								</a>
							</li>
						))
					}
				</ul>
				<p class={panelHeading}>Cities</p>
				<ul class="mt-2 space-y-1">
					{
						cities.map((city) => (
							<li>
								<a href={`/locations/${city.slug}`} class={panelLink}>
									{city.city}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			{
				mobileAfter.map((item) => (
					<a
						href={item.href}
						aria-current={currentPath === item.href ? 'page' : undefined}
						class={mobileNavLink}>
						{item.label}
					</a>
				))
			}

			<a href={faqHref} data-faq-link class={mobileNavLink}>FAQs</a>

			<div class="flex flex-col gap-3 pt-4">
				<BookOnlineButton class="w-full">Book Online</BookOnlineButton>
				<Button
					href={site.phoneHref}
					variant="outline"
					class={`w-full ${isDark ? 'text-white' : 'text-brand-red'}`}
				>
					Call {site.phone}
				</Button>
			</div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const menu = document.getElementById('mobile-menu');

	const setMenuOpen = (open: boolean) => {
		if (!menu || !toggle) return;
		menu.hidden = !open;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
		toggle
			.querySelector('[data-icon-close]')
			?.classList.toggle('hidden', !open);
	};

	toggle?.addEventListener('click', () => setMenuOpen(Boolean(menu?.hidden)));

	// FAQs link: already on the home page, so scroll to the section instead of
	// reloading it. Elsewhere the href takes over and lands on /#faqs.
	document.querySelectorAll<HTMLAnchorElement>('[data-faq-link]').forEach(
		(link) => {
			link.addEventListener('click', (event) => {
				const target = document.getElementById('faqs');
				if (!target) return;
				event.preventDefault();
				setMenuOpen(false);
				target.scrollIntoView({
					behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
						.matches
						? 'auto'
						: 'smooth',
				});
				history.replaceState(null, '', '#faqs');
			});
		},
	);

	// Desktop dropdowns ("Service Areas" and "More"): each opens on hover or
	// click and closes on outside click, Escape, or when the pointer leaves.
	document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
		const toggle = menu.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const panel = menu.querySelector<HTMLElement>('[data-menu-panel]');
		if (!toggle || !panel) return;

		const setOpen = (open: boolean) => {
			panel.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
			toggle
				.querySelector('[data-menu-chevron]')
				?.classList.toggle('rotate-180', open);
		};

		toggle.addEventListener('click', () => setOpen(panel.hidden));
		menu.addEventListener('mouseenter', () => setOpen(true));
		menu.addEventListener('mouseleave', () => setOpen(false));
		menu.addEventListener('focusout', (event) => {
			if (!menu.contains(event.relatedTarget as Node)) setOpen(false);
		});
		document.addEventListener('click', (event) => {
			if (!menu.contains(event.target as Node)) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			setOpen(false);
			toggle.blur();
		});
	});

	// Mobile accordion version of the same menu.
	const areasMobileToggle = document.querySelector<HTMLButtonElement>(
		'[data-areas-mobile-toggle]',
	);
	const areasMobilePanel = document.getElementById('mobile-service-areas');

	areasMobileToggle?.addEventListener('click', () => {
		if (!areasMobilePanel) return;
		const open = areasMobilePanel.hidden;
		areasMobilePanel.hidden = !open;
		areasMobileToggle.setAttribute('aria-expanded', String(open));
		areasMobileToggle
			.querySelector('[data-areas-chevron]')
			?.classList.toggle('rotate-180', open);
	});
</script>
